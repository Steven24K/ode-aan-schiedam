{
  "kind": "collectionType",
  "collectionName": "podcast_episodes",
  "info": {
    "singularName": "podcast-episode",
    "pluralName": "podcast-episodes",
    "displayName": "Podcast Episodes",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string",
      "required": true
    },
    "Description": {
      "type": "text",
      "required": true
    },
    "Thumbnail": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "Audio": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "audios"
      ]
    },
    "slug": {
      "type": "uid",
      "targetField": "Title",
      "required": true
    },
    "Blocks": {
      "type": "dynamiczone",
      "components": [
        "blocks.you-tube-video",
        "blocks.text",
        "blocks.text-image",
        "blocks.image",
        "blocks.image-slider",
        "blocks.form",
        "blocks.call-to-action-cta",
        "blocks.stories",
        "blocks.html-block"
      ]
    }
  }
}
