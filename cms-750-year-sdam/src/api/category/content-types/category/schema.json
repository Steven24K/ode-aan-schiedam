{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Category",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string",
      "required": true
    },
    "Description": {
      "type": "text",
      "required": true
    },
    "Color": {
      "type": "enumeration",
      "enum": [
        "just-black",
        "just-white",
        "fiery-red",
        "leafy-green",
        "sky-blue",
        "sunny-yellow",
        "royal-purple",
        "sunset-orange"
      ],
      "required": true,
      "default": "just-black"
    },
    "slug": {
      "type": "uid",
      "targetField": "Title",
      "required": true
    },
    "Blocks": {
      "type": "dynamiczone",
      "components": [
        "blocks.text",
        "blocks.text-image",
        "blocks.call-to-action-cta",
        "blocks.form",
        "blocks.image"
      ]
    }
  }
}
