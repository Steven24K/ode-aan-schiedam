{
  "kind": "singleType",
  "collectionName": "podcasts",
  "info": {
    "singularName": "podcast",
    "pluralName": "podcasts",
    "displayName": "Podcast",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string",
      "required": true
    },
    "Description": {
      "type": "text",
      "required": true
    },
    "Logo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "Creator": {
      "type": "string",
      "required": true
    },
    "Contact": {
      "type": "email",
      "required": true
    },
    "Category": {
      "type": "string"
    },
    "Platforms": {
      "type": "component",
      "repeatable": true,
      "component": "clickables.image-link",
      "required": false
    }
  }
}
